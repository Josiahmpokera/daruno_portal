# Shengena portal — local development settings
# Copy to .env (git-ignored) and adjust:  cp .env.example .env

# Base URL of the Laravel API.
#   Local dev:  http://127.0.0.1:8000   (php artisan serve)
#   LAN/phone:  http://<your-computer-ip>:8000  (start the API with --host=0.0.0.0)
#   Docker:     leave empty — the portal calls /api on the same domain
VITE_BASE_URL=http://127.0.0.1:8000
